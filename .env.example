# Copy to .env.local and fill in. Never commit .env.local.

# --- accounts -----------------------------------------------------------------------------------
BETTER_AUTH_SECRET=            # node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_URL=http://localhost:3000
# Extra addresses allowed to sign in (phones on the same Wi-Fi). Wildcards allowed.
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.*.*:3000,http://172.*.*.*:3000,http://10.*.*.*:3000

# --- database -----------------------------------------------------------------------------------
DATABASE_URL=file:data/local.db
# Production (Vercel + Turso): the integration injects these
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# --- AI (Google AI Studio, free tier) -----------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_API_KEY_DEMO=           # a second key used only by the demo account
# AI_PHOTOS_PER_DAY=6
# AI_CHATS_PER_DAY=30

# --- demo (never the default; see README) ---------------------------------------------------------
# DEMO_ENTRY=1
# DEMO_PASSWORD=
# DEMO_OFFLINE=1                 # serve saved, labelled answers instead of calling Gemini
# NEXT_PUBLIC_APP_URL=http://192.168.1.20:3000   # address in the demo's QR code

# --- voice (optional) -----------------------------------------------------------------------------
# TTS_VOICE_AR=ar-TN-ReemNeural
